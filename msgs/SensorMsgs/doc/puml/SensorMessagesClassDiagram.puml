@startuml
title Sensor Message Package Diagram

namespace fast::rf::messages {
  namespace StandardMsgs {
    class Covariance3DMsg <<(M,#FFFF00) >>
    class Vector3DMsg <<(M,#FFFF00)>>
  }
  namespace GeometryMsgs {
    class OrientationMsg <<(M,#FFFF00) >>
  }
  package SensorMsgs #LightYellow;line:blue {
    GlobalPositionCovarianceMsg --> Covariance3DMsg: <<use>>
    struct GlobalPositionSensorMsg <<(M,#FFFF00)>> #LimeGreen {
      +double time_stamp
      +double latitude_deg
      +double longitude_deg
      +double altitude_m
      +uint16_t satellites
      +Covariance3DMsg covariance
      +bool ok()
    }
    GlobalPositionSensorMsg --> Covariance3DMsg: <<use>>

    struct JoyMsg <<(M,#FFFF00)>> #LimeGreen {
      +double time_stamp
      +double[] axes
      +uint32[] buttons
    }

    struct ImuMsg <<(M,#FFFF00)>> #LimeGreen {
      +double time_stamp
      +uint64 seq
      +OrientationMsg orientation
      +Covariance3DMsg orientation_covariance
      +Vector3DMsg angular_velocity
      +Covariance3DMsg angular_velocity_covariance
      +Vector3DMsg linear_acceleration
      +Covariance3DMsg linear_acceleration_covariance
      +string pretty()
    }
    ImuMsg --> OrientationMsg: <<use>>
    ImuMsg --> Vector3DMsg: <<use>>
    ImuMsg --> Covariance3DMsg: <<use>>

    struct MagneticFieldMsg <<(M,#FFFF00)>> #LimeGreen {
      +double time_stamp
      +uint64 seq
      +Vector3DMsg magnetic_field
      +Covariance3DMsg magnetic_field_covariance
      +string pretty()
    }
    MagneticFieldMsg --> Vector3DMsg: <<use>>
    MagneticFieldMsg --> Covariance3DMsg: <<use>>
    enum PointFieldDataType #LimeGreen {

    }
    struct PointFieldMsg <<(M,#FFFF00)>> #LimeGreen {
        +string name
        +uint32 offset
        +PointFieldDataType datatype
        +uint32 count
    }
    PointFieldMsg +-- PointFieldDataType
    struct PointCloudMsg <<(M,#FFFF00)>> #LimeGreen {
        +{static} PointCloudMsg generateRGBCloud(uint32 dimension)
        +double time_stamp
        +uint32 height
        +uint32 width
        +PointFieldMsg[] fields
        +bool is_bigendian
        +uint32 point_step
        +uint32 row_step
        +uint8[] data
        +bool is_dense
    }
    PointCloudMsg --> PointFieldMsg: <<use>>
  }
  @enduml