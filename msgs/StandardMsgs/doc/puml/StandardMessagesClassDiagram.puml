@startuml
title Standard Messages Package Diagram

namespace fast::rf::messages {
  package StandardMsgs #LightYellow;line:blue {
    struct Vector3DMsg <<(M,#FFFF00) >> #LimeGreen {
      +double x
      +double y
      +double z
      +string pretty()
    }
    struct Covariance3DMsg <<(M,#FFFF00) >> #LimeGreen {
      +double[9] covariance
    }
    struct Covariance6DMsg <<(M,#FFFF00) >> #LimeGreen {
      +double[36] covariance
    }
}
@enduml