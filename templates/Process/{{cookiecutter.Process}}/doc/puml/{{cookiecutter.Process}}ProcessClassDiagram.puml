@startuml
title {{cookiecutter.Process}} Process Class Diagram

namespace fast::fr {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  namespace {{cookiecutter.System}}System {
    namespace {{cookiecutter.Subsystem}}Subsystem {
        interface I{{cookiecutter.Process}}Process  {
          +{abstract} bool init()
          +{abstract} DiagnosticMsg[] get_diagnostics()
          +{abstract} bool update(double current_time_sec, double delta_time_sec)
        }
        abstract Base{{cookiecutter.Process}}Process {
          +DiagnosticMsg[] get_diagnostics()
          +bool base_update(double current_time_sec, double delta_time_sec)
          #DiagnosticManager diagnosticManager

        }
        Base{{cookiecutter.Process}}Process -up-|> I{{cookiecutter.Process}}Process
        Base{{cookiecutter.Process}}Process --> DiagnosticManager: <<use>>
        class Basic{{cookiecutter.Process}}Process {
          +bool init()
          +bool update(double current_time_sec, double delta_time_sec)
        }
        Basic{{cookiecutter.Process}}Process -up-|> Base{{cookiecutter.Process}}Process
        class Dummy{{cookiecutter.Process}}Process {
          +bool update(double current_time_sec, double delta_time_sec)
        }
        Dummy{{cookiecutter.Process}}Process -up-|> Base{{cookiecutter.Process}}Process
    }
  }
}
@enduml