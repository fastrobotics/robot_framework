@startuml
title Example Process Class Diagram

namespace fast::rf {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
      class ReadyToArmStatusMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  interface IProcess
  namespace ExampleSystem {
    namespace ExampleSubsystem {
      package Example #LightYellow;line:blue {

        interface IExampleProcess  {
          +{abstract} bool init()
        }
        IExampleProcess -up-|> IProcess
        abstract BaseExampleProcess {
          +DiagnosticMsg[] getDiagnostics()
          +bool updateDiagnostic(DiagnosticType type, Level level, DiagnosticMessage message, string description)
          +ReadyToArmStatusMsg get_ready_to_arm()
          #bool update(double current_time_sec)
          #string pretty()
          #DiagnosticManager m_diagnosticManager
          #ReadyToArmStatusMsg ready_to_arm

        }
        BaseExampleProcess .up.|> IExampleProcess
        BaseExampleProcess --> DiagnosticManager: <<use>>
        class BasicExampleProcessConfig {
          +bool is_ok()
          +string pretty()
        }
        class BasicExampleProcess {
          +bool init()
          +bool set_config(BasicExampleProcessConfig config)
          +bool update(double current_time_sec)
	  +string pretty()
          -BasicExampleProcessConfig config_
        }
        BasicExampleProcess -up-|> BaseExampleProcess
        BasicExampleProcess *-> BasicExampleProcessConfig: <<use>>
        class DummyExampleProcess {
          +bool update(double current_time_sec)
        }
        DummyExampleProcess -up-|> BaseExampleProcess
      }
    }
  }
}
