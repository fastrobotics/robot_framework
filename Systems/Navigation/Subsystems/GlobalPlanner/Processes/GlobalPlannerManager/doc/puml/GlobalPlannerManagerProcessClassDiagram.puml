@startuml
title GlobalPlannerManager Process Class Diagram

namespace fast::rf {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  namespace NavigationSystem {
    namespace GlobalPlannerSubsystem {
      package GlobalPlannerManager #LightYellow;line:blue {
        interface IGlobalPlannerManagerProcess  {
          +{abstract} bool init()
          +{abstract} DiagnosticMsg[] get_diagnostics()
          +{abstract} bool update(double current_time_sec)
        }
        abstract BaseGlobalPlannerManagerProcess {
          +DiagnosticMsg[] get_diagnostics()
          +bool base_update(double current_time_sec)
          #DiagnosticManager diagnosticManager

        }
        BaseGlobalPlannerManagerProcess .up.|> IGlobalPlannerManagerProcess
        BaseGlobalPlannerManagerProcess --> DiagnosticManager: <<use>>
        class BasicGlobalPlannerManagerProcess {
          +bool update(double current_time_sec)
        }
        BasicGlobalPlannerManagerProcess -up-|> BaseGlobalPlannerManagerProcess
        class DummyGlobalPlannerManagerProcess {
          +bool update(double current_time_sec)
        }
        DummyGlobalPlannerManagerProcess -up-|> BaseGlobalPlannerManagerProcess
      }
    }
  }
}
@enduml