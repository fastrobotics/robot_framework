@startuml
title FreeSpacePlanner Process Class Diagram

namespace fast::rf {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  namespace NavigationSystem {
    namespace GlobalPlannerSubsystem {
      package FreeSpacePlanner #LightYellow;line:blue {
      
        interface IFreeSpacePlannerProcess  {
          +{abstract} bool init()
          +{abstract} DiagnosticMsg[] get_diagnostics()
          +{abstract} bool update(double current_time_sec)
        }
        abstract BaseFreeSpacePlannerProcess {
          +DiagnosticMsg[] get_diagnostics()
          +bool base_update(double current_time_sec)
          #DiagnosticManager diagnosticManager

        }
        BaseFreeSpacePlannerProcess .up.|> IFreeSpacePlannerProcess
        class BasicFreeSpacePlannerProcess {
          +bool init()
          +bool update(double current_time_sec)
        }
        BasicFreeSpacePlannerProcess -up-|> BaseFreeSpacePlannerProcess
        class DummyFreeSpacePlannerProcess {
          +bool update(double current_time_sec)
        }
        DummyFreeSpacePlannerProcess -up-|> BaseFreeSpacePlannerProcess
      }
    }
  }
}
@enduml