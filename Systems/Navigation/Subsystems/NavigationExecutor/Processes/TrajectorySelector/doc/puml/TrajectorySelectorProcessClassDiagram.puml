@startuml
title TrajectorySelector Process Class Diagram

namespace fast::rf {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  namespace NavigationSystem {
    namespace NavigationExecutorSubsystem {
      package TrajectorySelector #LightYellow;line:blue {
        interface ITrajectorySelectorProcess  {
          +{abstract} bool init()
          +{abstract} DiagnosticMsg[] getDiagnostics()
          +{abstract} bool update(double current_time_sec)
        }
        abstract BaseTrajectorySelectorProcess {
          +DiagnosticMsg[] getDiagnostics()
          +bool base_update(double current_time_sec)
          #DiagnosticManager diagnosticManager

        }
        BaseTrajectorySelectorProcess .up.|> ITrajectorySelectorProcess
        BaseTrajectorySelectorProcess --> DiagnosticManager: <<use>>
        class BasicTrajectorySelectorProcess {
          +bool init()
          +bool update(double current_time_sec)
        }
        BasicTrajectorySelectorProcess -up-|> BaseTrajectorySelectorProcess
        class DummyTrajectorySelectorProcess {
          +bool update(double current_time_sec)
        }
        DummyTrajectorySelectorProcess -up-|> BaseTrajectorySelectorProcess
      }
    }
  }
}
@enduml