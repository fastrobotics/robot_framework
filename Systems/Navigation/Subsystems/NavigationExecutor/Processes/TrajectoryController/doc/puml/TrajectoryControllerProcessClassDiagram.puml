@startuml
title TrajectoryController Process Class Diagram

namespace fast::rf {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
    }
    namespace GeometryMsgs {
      class OdomMsg <<(M,#FFFF00)>>
      class TwistMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  namespace NavigationSystem {
    interface IController
    class PIDController
    PIDController -up-|> IController
    package NavigationExecutorSubsystem #LightYellow;line:blue {
        interface ITrajectoryControllerProcess #LimeGreen  {
          +{abstract} bool init()
          +{abstract} DiagnosticMsg[] get_diagnostics()
          +{abstract} bool update(double current_time_sec)
          +{abstract} bool new_pose(OdomMsg pose)
          +{abstract} bool new_desired_command(TwistMsg cmd)
          +{abstract} bool get_command(TwistMsg cmd)
          +{abstract} string pretty()
        }
        abstract BaseTrajectoryControllerProcess #LimeGreen {
          +DiagnosticMsg[] get_diagnostics()
          +bool get_command(TwistMsg cmd)
          #bool init()
          #bool update(double current_time_sec)
          #bool new_pose(OdomMsg pose)
          #bool new_desired_command(TwistMsg cmd)
          #void set_command(TwistMsg command)
          #string pretty()
          #DiagnosticManager diagnosticManager
          #IController controller
          -TwistMsg command
          -bool is_new_command

        }
        BaseTrajectoryControllerProcess --> IController: <<use>>
        BaseTrajectoryControllerProcess --> DiagnosticManager: <<use>>
        BaseTrajectoryControllerProcess .up.|> ITrajectoryControllerProcess
        class BasicTrajectoryControllerProcess #LimeGreen {
          +bool init()
          +bool update(double current_time_sec)
          +string pretty()
          +bool new_pose(OdomMsg pose)
          +bool new_desired_command(TwistMsg cmd)
          +bool get_command(TwistMsg cmd)
         
        }
        BasicTrajectoryControllerProcess -up-|> BaseTrajectoryControllerProcess
        BasicTrajectoryControllerProcess *-> PIDController: <<use>>
        class DummyTrajectoryControllerProcess {
          +bool update(double current_time_sec)
        }
        DummyTrajectoryControllerProcess -up-|> BaseTrajectoryControllerProcess
    }
  }
}
@enduml