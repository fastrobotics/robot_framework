@startuml
title Controller Class Diagram
namespace fast::rf {
  namespace NavigationSystem  {
    package Controller #LightYellow;line:blue {
        enum ControllerType #LimeGreen {
            UNKNOWN=0,
            PID_CONTROLLER=1,
            END_OF_LIST=2
        }
        interface IControllerOutput #Orange {
            +bool is_new
            +double command_value
        }
        interface IControllerConfig #Orange {
            +set_parameters(double max_output, double min_output) 
            +double max_output
            +double min_output


        }
        interface IController #LimeGreen {
            +{abstract} bool init(IControllerConfig config)
            +{abstract} bool new_set_point(double set_point,double time_stamp_sec)
            +{abstract} bool new_sensor_input(double sensor_input,double time_stamp_sec)
            +{abstract} bool update(double current_time_sec)
            +{abstract} double get_sensor_delta_time_sec()
            +{abstract} bool get_output(IControllerOutput output)
            +{abstract} string pretty()

        }
        IController +-- ControllerType
        IController --> IControllerOutput: <<use>>
        IController --> IControllerConfig: <<use>>
        abstract BaseController #LimeGreen {
            +ControllerType get_controller_type()
            +double get_sensor_delta_time_sec()
            #bool init(IControllerConfig config)
            #bool new_set_point(double set_point,double time_stamp_sec)
            #bool new_sensor_input(double sensor_input,double time_stamp_sec)
            #bool update(double current_time_sec)
            #string pretty()
            #IControllerConfig config_
            -ControllerType controller_type
        }
        BaseController .up.|> IController
        class PIDControllerOutput #Orange {
            +double setpoint_sensor_error
            +double P_term
            +double I_term
            +double D_term
        }
        PIDControllerOutput -up-|> IControllerOutput
        class PIDControllerConfig #Orange {
            +void set_parameters(double P, double I, double D, double sensor_scale_factor)
            +double K_P
            +double K_I
            +double K_D
            +double sensor_scale
            

        }
        PIDControllerConfig -up-|> IControllerConfig
        class PIDController #Orange {
            +bool init(PIDControllerConfig config)
            +bool new_set_point(double set_point,double time_stamp_sec)
            +bool new_sensor_input(double sensor_input,double time_stamp_sec)
            +bool update(double current_time_sec)
            +bool get_output(PIDControllerOutput output)
            +string pretty()
        }
        PIDController -up-|> BaseController
        PIDController --> PIDControllerOutput: <<use>>
        PIDController --> PIDControllerConfig: <<use>>
    }
  }
}
@enduml