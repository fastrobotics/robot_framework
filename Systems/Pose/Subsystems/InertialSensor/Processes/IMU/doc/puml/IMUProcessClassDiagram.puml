@startuml
title IMU Process Class Diagram

namespace fast::rf {
  namespace DiagnosticDefinition {
    enum DiagnosticType
  }
  namespace messages {
    namespace InfrastructureMsgs {
      class DiagnosticMsg <<(M,#FFFF00)>>
      class ReadyToArmStatusMsg <<(M,#FFFF00)>>
    }
    namespace SensorMsgs {
      class ImuMsg <<(M,#FFFF00)>>
      class MagneticFieldMsg <<(M,#FFFF00)>>
    }
  }
  namespace core::Infrastructure {
    class DiagnosticManager
  }
  namespace PoseSystem {
    package InertialSensorSubsystem #LightYellow;line:blue {
        interface IIMUProcess #Yellow {
          +{abstract} bool init(IMUDevice device_type)
          +{abstract} DiagnosticMsg[] get_diagnostics()
          +{abstract} ReadyToArmStatusMsg get_ready_to_arm()
          +{abstract} bool update(double current_time_sec)
          +{abstract} string pretty()
          +{abstract} ImuMsg get_imu_data()
        }
        IIMUProcess --> IMUDevice: <<use>>
        
        abstract BaseIMUProcess #Yellow {
          +DiagnosticMsg[] get_diagnostics()
          +bool update(double current_time_sec)
          +ReadyToArmStatusMsg get_ready_to_arm()
          #string pretty()
          #DiagnosticManager diagnosticManager
          #ReadyToArmStatusMsg ready_to_arm
          -IIMUDriver driver

        }
        BaseIMUProcess .up.|> IIMUProcess
        BaseIMUProcess --> DiagnosticManager: <<use>>

        enum IMUDevice #Orange {
          UNKNOWN=0,
          MOCK_IMU=1,
          SYDTM151_IMU=2
          RAZOR9DOF_IMU = 3,
          END_OF_LIST=4,
        }
        interface IIMUDriver #Orange {
          +{abstract} bool init()
          +{abstract} string pretty()
          +{abstract} update(double current_time_sec)
          +{abstract} ImuMsg get_imu_data()
          +{abstract} MagneticFieldMsg get_magnetic_data()
        }
        IIMUDriver +-- IMUDevice
        abstract BaseIMUDriver #Orange {
          +ImuMsg get_imu_data()
          +MagneticFieldMsg get_magnetic_data()
          #bool init(IMUDevice imu_type)
          #update(double current_time_sec)
          #string pretty()
          #ImuMsg imu_data
          #MagneticFieldMsg magnetic_data
        }
        BaseIMUDriver .up.|> IIMUDriver

        class MockIMUDriver #Yellow {
           +bool init()
           +update(double current_time_sec)
           +string pretty()
           
        }
        MockIMUDriver -up-|> BaseIMUDriver

        class IMUSYDTM151Driver #Orange {
           +bool init()
           +update(double current_time_sec)
           +string pretty()
        }
        IMUSYDTM151Driver -up-|> BaseIMUDriver
        class IMURazor9DOFDriver #Orange {
           +bool init()
           +update(double current_time_sec)
           +string pretty()
        }
        IMURazor9DOFDriver -up-|> BaseIMUDriver
        class IMUProcess {
          +bool init(IMUDevice device_type)
          +bool update(double current_time_sec)
          +string pretty()
          +ImuMsg get_imu_data()
          
        }
        IMUProcess -up-|> BaseIMUProcess
        IMUProcess --> IIMUDriver
        class DummyIMUProcess {
          +bool init(IMUDevice device_type)
          +bool update(double current_time_sec)
          +string pretty()
          +ImuMsg get_imu_data()
        }
        DummyIMUProcess -up-|> BaseIMUProcess
        DummyIMUProcess --> IIMUDriver
        DummyIMUProcess *-> MockIMUDriver
    }
  }
}
@enduml